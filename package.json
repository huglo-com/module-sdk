{
  "name": "@huglo/module-sdk",
  "version": "1.2.3",
  "description": "TypeScript SDK for Huglo federation modules",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sonar": "dotenv -- sonar",
    "sonar:ci": "npm run test:coverage && npm run sonar"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huglo-com/module-sdk.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "huglo-module-sdk": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "canonicalize": "^3.0.0",
    "content-disposition": "^2.0.1",
    "hono": "^4.12.24",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@sonar/scan": "^4.3.6",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
