# Ed25519 private key (PEM) or path to PEM file
MODULE_PRIVATE_KEY_PATH=./examples/trovi/private.pem

# Huglo registration challenge (issued by Huglo UI during pending registration)
MODULE_CHALLENGE=

# Public base URL registered in Huglo (must match what you submitted in the UI)
MODULE_ENDPOINT=https://your-module.example.com

# Optional: Huglo directory URL (defaults to https://account.huglo.com)
# HUGLO_DIRECTORY_URL=https://account.huglo.com

# Config login OAuth (required when using module.config())
# HUGLO_OAUTH_CLIENT_ID=
# HUGLO_OAUTH_CLIENT_SECRET=
# HUGLO_OAUTH_REDIRECT_URI=https://your-module.example.com/config/callback
# Optional issuer base (defaults to https://account.huglo.com/api/auth — foaf-auth Better Auth)
# HUGLO_OAUTH_ISSUER=https://account.huglo.com/api/auth
# HUGLO_OAUTH_SCOPES=openid profile email
